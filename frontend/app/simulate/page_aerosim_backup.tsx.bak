"use client";

import { useEffect, useRef, useState } from "react";
import Navbar from "@/components/Navbar";

const API = "http://localhost:8000";
const WS_URL = "ws://localhost:8000/ws";

const FAULT_CHANNELS = [
  { key: "egt", label: "EGT" },
  { key: "cht", label: "CHT" },
  { key: "oil_pressure", label: "Oil Pressure" },
  { key: "oil_temp", label: "Oil Temp" },
  { key: "vibx", label: "Vib X" },
  { key: "viby", label: "Vib Y" },
  { key: "vibz", label: "Vib Z" },
  { key: "rpm", label: "RPM" },
];
const FAULT_CODE_TO_NAME: Record<number, string> = { 0: "none", 1: "Bias", 2: "Drift", 3: "Spike", 4: "Stuck-At", 5: "Noise" };

type AiResult = {
  status: string;
  fault_detected?: boolean;
  detection_confidence?: number;
  faulty_channels?: string[];
  diagnosis?: Record<string, { fault_type: string; confidence: number }>;
  severity_percent?: Record<string, number>;
  health_percent?: number;
  rul_percent_remaining?: number;
  rul_hours_internal?: number;
  steps_collected?: number;
  steps_needed?: number;
};

type Telemetry = {
  time?: number;
  engine_rpm?: number; prop_rpm?: number; power_kw?: number; torque_available_nm?: number;
  fuel_flow?: number; thrust?: number; drag?: number; lift?: number; air_density?: number;
  thrust_margin?: number; lift_weight_margin?: number; egt?: number; cht?: number;
  oil_pressure?: number; oil_temp?: number; vibx?: number; viby?: number; vibz?: number;
  fault_stress?: Record<string, number>;
  fault_flags?: Record<string, number>;
  ai?: AiResult;
};

export default function SimulatePage() {
  const [running, setRunning] = useState(false);
  const [telemetry, setTelemetry] = useState<Telemetry | null>(null);
  const [altitude, setAltitude] = useState(2000);
  const [throttle, setThrottle] = useState(0.5);
  const [airspeed, setAirspeed] = useState(40);
  const [aoa, setAoa] = useState(5);
  const wsRef = useRef<WebSocket | null>(null);

  useEffect(() => {
    const ws = new WebSocket(WS_URL);
    wsRef.current = ws;
    ws.onmessage = (event) => setTelemetry(JSON.parse(event.data));
    ws.onerror = () => console.log("WebSocket error - is the backend running on :8000?");
    return () => ws.close();
  }, []);

  const start = async () => { await fetch(`${API}/start`, { method: "POST" }); setRunning(true); };
  const stop = async () => { await fetch(`${API}/stop`, { method: "POST" }); setRunning(false); };
  const reset = async () => { await fetch(`${API}/reset`, { method: "POST" }); };

  const pushParams = async (next: Record<string, number>) => {
    await fetch(`${API}/params`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(next),
    });
  };

  const onAltitude = (v: number) => { setAltitude(v); pushParams({ altitude: v }); };
  const onThrottle = (v: number) => { setThrottle(v); pushParams({ throttle: v }); };
  const onAirspeed = (v: number) => { setAirspeed(v); pushParams({ airspeed: v }); };
  const onAoa = (v: number) => { setAoa(v); pushParams({ aoa: v }); };

  const t = telemetry || {};
  const ai = t.ai || null;
  const fmt = (x: number | undefined, d = 1) => (typeof x === "number" ? x.toFixed(d) : "--");

  return (
    <>
      <Navbar />

      <main className="flex-grow pt-16 relative">
        <div className="absolute inset-0 grid-bg pointer-events-none opacity-50 z-0" />

        <div className="relative z-10 max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16">
          <header className="mb-10 flex flex-col md:flex-row md:items-end md:justify-between gap-4 text-center md:text-left">
            <div>
              <h1 className="font-headline-display text-[30px] md:text-[40px] leading-[1.15] font-bold text-primary uppercase tracking-tight mb-2">
                LIVE SIMULATION
              </h1>
              <p className="text-tertiary/80 text-[13px] tracking-[0.15em] uppercase font-mono">
                ROTAX 914 UL/F - real-time telemetry and AI fault prediction.
              </p>
            </div>
            <div className="flex items-center justify-center md:justify-end gap-4">
              <span className="text-[13px] tracking-wide text-on-surface-variant font-mono">
                {t.time !== undefined ? `T+${fmt(t.time, 1)}s` : "T+--"}
              </span>
              <div className={`flex items-center gap-2 px-3 py-1.5 rounded border text-[11px] tracking-[0.1em] font-bold uppercase font-mono ${
                running ? "border-tertiary text-tertiary bg-tertiary/10" : "border-outline-variant text-on-surface-variant bg-surface-container-highest/60"
              }`}>
                <span className={`w-2 h-2 rounded-full ${running ? "bg-tertiary animate-pulse" : "bg-on-surface-variant"}`} />
                {running ? "RUNNING" : "STOPPED"}
              </div>
            </div>
          </header>

          {/* Controls */}
          <section className="mb-10">
            <div className="bg-surface/80 backdrop-blur-xl border border-tertiary/30 rounded-lg p-6">
              <div className="flex gap-3 mb-6">
                <button onClick={start} disabled={running}
                  className="px-6 py-3 bg-tertiary text-black text-[11px] tracking-[0.1em] font-bold uppercase rounded hover:brightness-110 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                  Start
                </button>
                <button onClick={stop} disabled={!running}
                  className="px-6 py-3 border border-outline-variant/50 text-primary text-[11px] tracking-[0.1em] font-bold uppercase rounded hover:border-tertiary hover:text-tertiary transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                  Stop
                </button>
                <button onClick={reset}
                  className="px-6 py-3 border border-outline-variant/50 text-on-surface-variant text-[11px] tracking-[0.1em] font-bold uppercase rounded hover:border-tertiary hover:text-tertiary transition-colors">
                  Reset
                </button>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <SliderControl label="Altitude" value={altitude} unit="m" min={0} max={8000} step={50} onChange={onAltitude} />
                <SliderControl label="Throttle" value={throttle} unit="" min={0} max={1} step={0.01} decimals={2} onChange={onThrottle} />
                <SliderControl label="Airspeed" value={airspeed} unit="m/s" min={0} max={80} step={1} onChange={onAirspeed} />
                <SliderControl label="Angle of Attack" value={aoa} unit="deg" min={-15} max={25} step={0.5} onChange={onAoa} />
              </div>
            </div>
          </section>

          {/* AI Predictions */}
          <section className="mb-10">
            <h2 className="font-headline-display text-xl text-primary uppercase mb-1">AI Predictions</h2>
            <p className="text-on-surface-variant text-sm mb-6">
              Live model output - compare against ground truth below.
            </p>

            {(!ai || ai.status !== "ok") && (
              <div className="bg-surface/80 backdrop-blur-xl border border-outline-variant/40 rounded-lg p-6 text-on-surface-variant text-sm">
                {!ai && "Start the simulation to see live predictions."}
                {ai?.status === "warming_up" && ai.steps_collected !== undefined && ai.steps_needed !== undefined && (
                  <div>
                    <div className="font-mono text-[13px] mb-2">
                      Buffering history: {ai.steps_collected} / {ai.steps_needed}s
                    </div>
                    <div className="h-1.5 bg-black/60 rounded overflow-hidden">
                      <div className="h-full bg-tertiary transition-all duration-300"
                        style={{ width: `${(100 * ai.steps_collected) / ai.steps_needed}%` }} />
                    </div>
                  </div>
                )}
                {ai?.status === "ai_service_unavailable" && "AI service unavailable - is ai.py running on :8100?"}
              </div>
            )}

            {ai?.status === "ok" && (
              <>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                  <StatCard label="Fault Status" value={ai.fault_detected ? "DETECTED" : "NOMINAL"}
                    tone={ai.fault_detected ? "danger" : "good"} />
                  <StatCard label="Confidence" value={`${Math.round((ai.detection_confidence ?? 0) * 100)}%`} tone="neutral" />
                  <StatCard label="Health" value={`${(ai.health_percent ?? 0).toFixed(1)}%`}
                    tone={(ai.health_percent ?? 0) >= 70 ? "good" : (ai.health_percent ?? 0) >= 30 ? "warn" : "danger"} />
                  <StatCard label="RUL Remaining" value={`${(ai.rul_percent_remaining ?? 0).toFixed(1)}%`}
                    tone={(ai.rul_percent_remaining ?? 0) >= 70 ? "good" : (ai.rul_percent_remaining ?? 0) >= 30 ? "warn" : "danger"} />
                </div>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                  {FAULT_CHANNELS.map((ch) => {
                    const faultType = ai.diagnosis?.[ch.key]?.fault_type ?? "none";
                    const pct = Math.round((ai.severity_percent?.[ch.key] ?? 0));
                    const active = faultType !== "none";
                    return (
                      <div key={`ai-${ch.key}`}
                        className={`bg-surface/80 backdrop-blur-xl border rounded-lg p-4 ${active ? "border-tertiary/60" : "border-outline-variant/30"}`}>
                        <div className="flex justify-between text-[12px] text-on-surface-variant mb-1">
                          <span>{ch.label}</span>
                          <span className="font-mono">{pct}%</span>
                        </div>
                        <div className="h-1.5 bg-black/60 rounded overflow-hidden mb-2">
                          <div className={`h-full transition-all duration-300 ${active ? "bg-tertiary" : "bg-on-surface-variant/40"}`}
                            style={{ width: `${Math.min(100, pct)}%` }} />
                        </div>
                        <div className={`text-[12px] font-mono font-bold ${active ? "text-tertiary" : "text-on-surface-variant"}`}>
                          {active ? faultType : "OK"}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </>
            )}
          </section>

          {/* Ground Truth - visually secondary, matching the engine page's treatment of
              non-primary content (reduced opacity) */}
          <section className="mb-10 opacity-75">
            <h2 className="font-headline-display text-xl text-on-surface-variant uppercase mb-1">Ground Truth</h2>
            <p className="text-on-surface-variant/70 text-sm mb-6">
              Actual injected fault state from the physics engine.
            </p>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              {FAULT_CHANNELS.map((ch) => {
                const flagCode = t.fault_flags?.[ch.key] ?? 0;
                const faultType = FAULT_CODE_TO_NAME[flagCode] ?? "none";
                const stress = t.fault_stress?.[ch.key] ?? 0;
                const pct = Math.round(Math.min(1, stress) * 100);
                const active = faultType !== "none";
                return (
                  <div key={`gt-${ch.key}`} className="border border-outline-variant/30 rounded-lg p-4">
                    <div className="flex justify-between text-[12px] text-on-surface-variant mb-1">
                      <span>{ch.label}</span>
                      <span className="font-mono">{pct}%</span>
                    </div>
                    <div className="h-1.5 bg-black/60 rounded overflow-hidden mb-2">
                      <div className={`h-full transition-all duration-300 ${active ? "bg-on-surface-variant" : "bg-on-surface-variant/30"}`}
                        style={{ width: `${pct}%` }} />
                    </div>
                    <div className="text-[12px] font-mono font-bold text-on-surface-variant">
                      {active ? faultType : "OK"}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>

          {/* Telemetry */}
          <section>
            <h2 className="font-headline-display text-xl text-primary uppercase mb-6">Telemetry</h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
              <TelemetryCard label="Engine RPM" value={fmt(t.engine_rpm, 0)} />
              <TelemetryCard label="Prop RPM" value={fmt(t.prop_rpm, 0)} />
              <TelemetryCard label="Power" value={fmt(t.power_kw)} unit="kW" />
              <TelemetryCard label="Torque Avail" value={fmt(t.torque_available_nm)} unit="Nm" />
              <TelemetryCard label="Fuel Flow" value={fmt(t.fuel_flow)} unit="kg/h" />
              <TelemetryCard label="Thrust" value={fmt(t.thrust)} unit="N" />
              <TelemetryCard label="Drag" value={fmt(t.drag)} unit="N" />
              <TelemetryCard label="Lift" value={fmt(t.lift, 0)} unit="N" />
              <TelemetryCard label="Air Density" value={fmt(t.air_density, 3)} />
              <TelemetryCard label="Thrust Margin" value={fmt(t.thrust_margin)} unit="N" warn={(t.thrust_margin ?? 0) < 0} />
              <TelemetryCard label="Lift/Weight Margin" value={fmt(t.lift_weight_margin, 0)} warn={(t.lift_weight_margin ?? 0) < 0} />
              <TelemetryCard label="EGT" value={fmt(t.egt)} unit="C" />
              <TelemetryCard label="CHT" value={fmt(t.cht)} unit="C" />
              <TelemetryCard label="Oil Pressure" value={fmt(t.oil_pressure)} />
              <TelemetryCard label="Oil Temp" value={fmt(t.oil_temp)} unit="C" />
              <TelemetryCard label="Vibration X/Y/Z" value={`${fmt(t.vibx, 3)} / ${fmt(t.viby, 3)} / ${fmt(t.vibz, 3)}`} />
            </div>
          </section>
        </div>
      </main>

      <footer className="bg-surface-container-lowest w-full border-t border-outline-variant/30 z-10 relative">
        <div className="flex flex-col md:flex-row justify-between items-center px-6 py-6 gap-4 w-full">
          <div className="text-[11px] tracking-[0.1em] font-bold uppercase text-on-surface-variant text-center md:text-left">
            &copy; 2026 AERO-SIM AEROSPACE. ALL SYSTEMS NOMINAL.
          </div>
          <div className="flex flex-wrap justify-center gap-4">
            <a className="text-[11px] tracking-[0.1em] font-bold uppercase text-on-surface-variant hover:text-tertiary transition-colors" href="#">Terms of Flight</a>
            <a className="text-[11px] tracking-[0.1em] font-bold uppercase text-on-surface-variant hover:text-tertiary transition-colors" href="#">Privacy Policy</a>
            <a className="text-[11px] tracking-[0.1em] font-bold uppercase text-on-surface-variant hover:text-tertiary transition-colors" href="#">API Docs</a>
          </div>
        </div>
      </footer>
    </>
  );
}

function SliderControl({
  label, value, unit, min, max, step, decimals = 0, onChange,
}: {
  label: string; value: number; unit: string; min: number; max: number; step: number;
  decimals?: number; onChange: (v: number) => void;
}) {
  return (
    <div>
      <div className="flex justify-between mb-2">
        <span className="text-[13px] text-on-surface-variant">{label}</span>
        <span className="text-[13px] font-mono text-primary">{value.toFixed(decimals)}{unit && ` ${unit}`}</span>
      </div>
      <input type="range" min={min} max={max} step={step} value={value}
        onChange={(e) => onChange(parseFloat(e.target.value))}
        className="w-full accent-[#FF9100]" />
    </div>
  );
}

function StatCard({ label, value, tone }: { label: string; value: string; tone: "good" | "warn" | "danger" | "neutral" }) {
  const colors = {
    good: "border-tertiary/60 text-tertiary",
    warn: "border-yellow-500/60 text-yellow-400",
    danger: "border-red-500/60 text-red-400",
    neutral: "border-outline-variant/40 text-primary",
  }[tone];
  return (
    <div className={`bg-surface/80 backdrop-blur-xl border rounded-lg p-4 ${colors}`}>
      <div className="text-[11px] text-on-surface-variant uppercase tracking-wide mb-1">{label}</div>
      <div className="text-lg font-headline-display font-bold">{value}</div>
    </div>
  );
}

function TelemetryCard({ label, value, unit, warn }: { label: string; value: string; unit?: string; warn?: boolean }) {
  return (
    <div className={`bg-surface/80 backdrop-blur-xl border rounded-lg p-4 ${warn ? "border-red-500/60" : "border-outline-variant/30"}`}>
      <div className="text-[11px] text-on-surface-variant mb-1">{label}</div>
      <div className={`text-[17px] font-mono ${warn ? "text-red-400" : "text-primary"}`}>
        {value}{unit && <span className="text-[12px] text-on-surface-variant"> {unit}</span>}
      </div>
    </div>
  );
}

# macOS and editor files
.DS_Store
.vscode/
.idea/

# Validation experiments are local-only and must never be committed.
/validation/

# Frontend (Next.js / Node.js)
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/coverage/
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
!/frontend/.env.*.example

# Backend (Python)
/backend/.venv/
/backend/venv/
/backend/env/
/backend/__pycache__/
/backend/**/*.py[cod]
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/.coverage
/backend/htmlcov/
/backend/.env
/backend/.env.*
!/backend/.env.example
!/backend/.env.*.example

# Local Python environments and build artifacts anywhere else in the repo
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Logs and temporary files
*.log
*.tmp

# ─── macOS & editor ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*.swo

# ─── Local tool state ─────────────────────────────────────────────────────────
.playwright-mcp/
.serena/
.logs/
/backend/.residual_offsets.json
/backend/.residual_offsets.json.tmp
# TFLite edge exports: build output of validation/export_edge.py (report in validation/models/)
/backend/models_v3/*/edge/

# ─── Validation (local-only — datasets, notebooks, trained model artifacts) ───
# Everything under validation/ stays local except the training/evaluation code.
/validation/*
!/validation/*.py
!/validation/requirements.txt
!/validation/*.ipynb

# ─── Large binary transfer files ──────────────────────────────────────────────
/validation/logs/
*.candidate.keras
*.candidate.prev.keras
model_b64_transfer.txt
*.b64

# ─── Frontend (Next.js / Node.js) ─────────────────────────────────────────────
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/coverage/
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts

# Frontend env files — never commit secrets
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local
/frontend/.env.development
/frontend/.env.production
# Allow the template to be committed
!/frontend/.env.example

# ─── Backend (Python — physics venv) ──────────────────────────────────────────
/backend/.venv/
/backend/.venv
/backend/venv/
/backend/venv
/backend/env/
/backend/env
/backend/myenv/
/backend/myenv
myenv/
myenv

# Backend env files — never commit secrets
/backend/.env
/backend/.env.*
!/backend/.env.example

# Python cache and build artifacts
/backend/__pycache__/
/backend/**/__pycache__/
/backend/**/*.py[cod]
/backend/*.py[cod]
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/.coverage
/backend/htmlcov/

